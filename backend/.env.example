# Copy to backend/.env and fill in real values. Never commit backend/.env.

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Used by both docker-compose.yml and Django settings.
POSTGRES_DB=campusleague
POSTGRES_USER=campusleague
POSTGRES_PASSWORD=change-me
# Host port 5433, not the default 5432, to avoid clashing with any other
# PostgreSQL already running on your machine.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Optional. Requests per client IP, as "<number>/<sec|min|hour|day>".
# Raise these if several people share one IP (for example behind the Vite
# dev proxy on demo day).
THROTTLE_LOGIN_RATE=20/min
THROTTLE_SIGNUP_RATE=10/min

# Optional. Password given to every account created by `manage.py seed_demo`.
# DEMO_PASSWORD=skyline-demo-2026

# Optional. verify-email and resend-code requests per client IP.
THROTTLE_OTP_RATE=30/min

# Email. Leave EMAIL_HOST blank to print emails to the terminal (development).
# Set it to send real email through an SMTP server. Put real values ONLY in
# backend/.env, never in this file or anywhere else in the repository.
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=
DEFAULT_FROM_EMAIL=

# Payments. "mock" (default) or "razorpay" (Razorpay TEST mode keys only).
# With "razorpay" and either key blank, the server falls back to mock and
# logs a warning. Put real key values ONLY in backend/.env.
PAYMENT_GATEWAY=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
