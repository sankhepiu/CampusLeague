# Copy to backend/.env and fill in real values. Never commit backend/.env.

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Used by both docker-compose.yml and Django settings.
POSTGRES_DB=campusleague
POSTGRES_USER=campusleague
POSTGRES_PASSWORD=change-me
# Host port 5433, not the default 5432, to avoid clashing with any other
# PostgreSQL already running on your machine.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
