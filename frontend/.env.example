# Base URL of the Campus League backend API. "/api" routes through the Vite
# dev server's proxy (see vite.config.ts) to http://127.0.0.1:8000/api — the
# backend sends no CORS headers by design, so the browser can't call it
# directly; the proxy is what makes that work.
VITE_API_BASE_URL=/api

# When "true" (or unset), the app runs entirely on the built-in mock API and
# needs no backend. Set to "false" to talk to a real server.
VITE_USE_MOCK_API=false
